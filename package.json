{
  "name": "chatgpt-fold",
  "version": "0.1.7",
  "private": true,
  "description": "A small, local-only ChatGPT answer folding extension.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test tests/policy.test.cjs",
    "test:dom": "node tests/adapter-dom.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:paint": "node tests/browser-first-paint.cjs",
    "test:state": "node tests/browser-open-state.cjs",
    "test:maintenance": "node tests/browser-maintenance.cjs",
    "test:native-probe": "node tests/native-lifecycle-probe.cjs",
    "test:asset-inventory": "node tests/renderer-asset-inventory.cjs",
    "test:fold-window": "node tests/fold-window-probe.cjs",
    "test:body-host": "node tests/assistant-body-host.cjs",
    "study:memory": "node experiments/long-session-memory.cjs",
    "test:long-session": "node --test tests/long-session-stats.cjs tests/long-session-cli.cjs",
    "bench:memory": "node tests/memory-benchmark.cjs"
  }
}
